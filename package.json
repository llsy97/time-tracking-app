{
  "name": "time-keeping-app",
  "version": "1.0.0",
  "description": "moa: an offline-ready mobile-first time tracker with local accounts and daily summaries.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "web": "node server.js --open",
    "test": "node --test --test-isolation=none tests/time-utils.test.cjs tests/google-auth.test.cjs",
    "test:ui": "node tests/ui.test.cjs",
    "build": "electron-builder --win portable",
    "android:sync": "npm run build:auth && node tools/prepare-android.cjs && cap sync android",
    "android:apk": "npm run android:sync && node tools/build-android.cjs",
    "build:auth": "node tools/build-auth.cjs"
  },
  "build": {
    "appId": "app.tempo.local",
    "productName": "moa",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "script.js",
      "time-utils.js",
      "icon.svg",
      "icon-192.png",
      "icon-512.png",
      "manifest.webmanifest",
      "icon-maskable-512.png",
      "favicon-48.png",
      "cloud-auth-ui.js"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^31.7.1",
    "electron-builder": "^24.13.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "firebase": "^12.19.0",
    "google-auth-library": "^11.1.0"
  }
}
