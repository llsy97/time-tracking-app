<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="moa" android:textStyle="bold" android:textSize="20sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="@color/widget_muted" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF5D22" android:textSize="8sp" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready for your next task" android:textColor="@color/widget_text" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <Chronometer android:id="@+id/widget_timer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="26dp" android:gravity="center_vertical" android:textColor="@color/widget_text" android:textSize="23sp" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_static_timer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="26dp" android:gravity="center_vertical" android:text="00:00:00" android:textColor="@color/widget_text" android:textSize="23sp" android:fontFamily="monospace" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp">
        <TextView android:id="@+id/widget_toggle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Start" android:textColor="#171914" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/widget_stop" android:layout_width="50dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:gravity="center" android:text="Stop" android:textColor="@color/widget_text" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
